#!/bin/sh

uci -q batch <<'EOF'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.3.7'
set network.lan.netmask='255.255.255.0'
set network.lan.gateway='192.168.3.2'
delete network.lan.dns
add_list network.lan.dns='192.168.3.2'
delete network.lan.ip6assign

set dhcp.lan='dhcp'
set dhcp.lan.interface='lan'
set dhcp.lan.ignore='1'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ra='disabled'
set dhcp.lan.ndp='disabled'

set luci.main.mediaurlbase='/luci-static/bootstrap'

commit network
commit dhcp
commit luci
EOF

printf '%s\n' '123456' '123456' | passwd root >/dev/null 2>&1

# The USB Burning Tool image allocates the remainder of the 8 GB eMMC to p2,
# while the ext4 filesystem initially retains the compact build-time size.
# Grow the mounted root filesystem online on first boot.
root_device="$(readlink -f /dev/root 2>/dev/null)"
if [ ! -b "$root_device" ]; then
	for argument in $(cat /proc/cmdline); do
		case "$argument" in
			root=/dev/*) root_device="${argument#root=}" ;;
		esac
	done
fi

case "$root_device" in
	/dev/mmcblk*p2)
		resize2fs "$root_device" || exit 1
		;;
esac

exit 0
